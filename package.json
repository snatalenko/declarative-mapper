{
  "name": "morphos",
  "version": "2.0.0",
  "description": "JSON-to-JSON mapper with user-defined JSON mapping specs, plain JS transformation expressions, and isolated VM execution.",
  "keywords": [
    "config-driven",
    "data-mapper",
    "data-transformation",
    "json-mapper",
    "json-to-json",
    "json-transformation",
    "json-transformer",
    "json",
    "mapper",
    "mapping",
    "declarative-mapper",
    "nodejs",
    "object-mapper",
    "object-mapping",
    "transformation",
    "typescript",
    "react"
  ],
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "main": "dist/cjs/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./utils": {
      "require": "./dist/cjs/utils/index.js",
      "import": "./dist/esm/utils/index.js",
      "types": "./dist/types/utils/index.d.ts"
    },
    "./react": {
      "require": "./dist/cjs/react/index.js",
      "import": "./dist/esm/react/index.js",
      "types": "./dist/types/react/index.d.ts"
    },
    "./react/bootstrap34": {
      "require": "./dist/cjs/react/bootstrap34/index.js",
      "import": "./dist/esm/react/bootstrap34/index.js",
      "types": "./dist/types/react/bootstrap34/index.d.ts"
    },
    "./react/bootstrap53": {
      "require": "./dist/cjs/react/bootstrap53/index.js",
      "import": "./dist/esm/react/bootstrap53/index.js",
      "types": "./dist/types/react/bootstrap53/index.d.ts"
    },
    "./react-schema-editor": {
      "require": "./dist/cjs/react-schema-editor/index.js",
      "import": "./dist/esm/react-schema-editor/index.js",
      "types": "./dist/types/react-schema-editor/index.d.ts"
    },
    "./react-schema-editor/bootstrap34": {
      "require": "./dist/cjs/react-schema-editor/bootstrap34/index.js",
      "import": "./dist/esm/react-schema-editor/bootstrap34/index.js",
      "types": "./dist/types/react-schema-editor/bootstrap34/index.d.ts"
    },
    "./react-schema-editor/bootstrap53": {
      "require": "./dist/cjs/react-schema-editor/bootstrap53/index.js",
      "import": "./dist/esm/react-schema-editor/bootstrap53/index.js",
      "types": "./dist/types/react-schema-editor/bootstrap53/index.d.ts"
    },
    "./openai": {
      "require": "./dist/cjs/openai/index.js",
      "import": "./dist/esm/openai/index.js",
      "types": "./dist/types/openai/index.d.ts"
    },
    "./anthropic": {
      "require": "./dist/cjs/anthropic/index.js",
      "import": "./dist/esm/anthropic/index.js",
      "types": "./dist/types/anthropic/index.d.ts"
    }
  },
  "files": [
    "dist/**",
    "!dist/.tsbuildinfo*",
    "utils/**",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "openai": ">=4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "scripts": {
    "cleanup": "rm -rf ./dist ./coverage",
    "playground": "vite",
    "build:playground": "vite build",
    "test": "jest",
    "test:performance": "jest tests/**/*.performance.test.ts",
    "test:security": "jest tests/**/*.security.test.ts",
    "test:coverage": "jest --collect-coverage",
    "changelog": "conventional-changelog -n ./changelog.config.mjs --infile /dev/null --stdout -r 0 > CHANGELOG.md",
    "rebuild": "npm run cleanup && npm run build",
    "build:schema": "node ./scripts/gen-schema.mjs",
    "build": "npm run build:esm && npm run build:cjs && npm run build:schemas && npm run build:schema",
    "build:cjs": "tsc -p ./tsconfig.cjs.json && cp ./scripts/etc/cjs-package.json ./dist/cjs/package.json",
    "build:esm": "tsc -p ./tsconfig.esm.json",
    "build:schemas": "mkdir -p ./dist/schemas && cp ./schemas/*.json ./dist/schemas/",
    "prepack": "npm t && npm run rebuild",
    "preversion": "npm audit --audit-level=high && npm t",
    "version": "./scripts/cleanup_obsolete_tags.sh v$npm_package_version && npm run changelog && git add CHANGELOG.md",
    "lint": "eslint"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/snatalenko/morphos.git"
  },
  "author": {
    "name": "Stanislav Natalenko",
    "url": "https://natalenko.com/about/",
    "email": "taxer.32-dense@icloud.com"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/snatalenko/morphos/issues"
  },
  "homepage": "https://github.com/snatalenko/morphos#readme",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@types/chai": "^4.3.20",
    "@types/jest": "^29.5.14",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "chai": "^4.5.0",
    "conventional-changelog": "^8.1.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "^10.8.1",
    "eslint-plugin-jest": "^29.16.0",
    "globals": "^17.9.0",
    "jest": "^29.7.0",
    "jsonschema": "^1.5.0",
    "openai": "^6.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  }
}
